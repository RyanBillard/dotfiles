[include]
	path = ~/.gitconfig.local
[alias]
	co = checkout
	d = diff
	s = status
	um = !git co main && git pull origin main --ff && git co -
	re = rebase main
	ure = !git um && git re
	urefs = !git um && git rebase main --update-refs
	amend = commit -a --amend --no-edit
	nb = !git co main && git um && git co -b
	cu = "!git fetch --all -p && git branch -vv | grep ': gone]' | awk '{ print $1 }' | xargs git branch -D"
	fco = "!f() { git fetch origin $1 && git checkout $1; }; f"
